{
    "name": "anabil/laravel-wallet",
    "description": "Race-safe Laravel wallets with an immutable ledger, multi-guard holders, transfers, reversals and exact decimal amounts.",
    "keywords": [
        "laravel",
        "wallet",
        "balance",
        "ledger",
        "transactions",
        "money",
        "payments"
    ],
    "homepage": "https://github.com/anabiiil/laravel-wallet",
    "license": "MIT",
    "authors": [
        {
            "name": "Abd El-Rahman Nabil",
            "email": "a.nabiil@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Anabil\\Wallet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anabil\\Wallet\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Anabil\\Wallet\\WalletServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
